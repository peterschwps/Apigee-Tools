<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-RateLimitHeaders">
    <DisplayName>AM-RateLimitHeaders</DisplayName>
    <Set>
        <Headers>
            <Header name="X-RateLimit-Limit">{ratelimit.Q-PerApp.allowed.count}</Header>
            <Header name="X-RateLimit-Remaining">{ratelimit.Q-PerApp.available.count}</Header>
            <Header name="X-RateLimit-Reset">{ratelimit.Q-PerApp.expiry.time}</Header>
        </Headers>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
