<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="default">
    <Description>Legacy storefront backend with a standby server.</Description>
    <FaultRules>
        <FaultRule name="backendUnavailable">
            <Step>
                <Name>AM-BackendUnavailable</Name>
            </Step>
            <Condition>(fault.name = "ServiceUnavailable") or (fault.name = "NoActiveTargets") or (fault.name = "GatewayTimeout")</Condition>
        </FaultRule>
    </FaultRules>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>SetLegacyHeaders</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows/>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <HTTPTargetConnection>
        <Properties>
            <Property name="io.timeout.millis">30000</Property>
        </Properties>
        <LoadBalancer>
            <Algorithm>RoundRobin</Algorithm>
            <Server name="legacy-soap"/>
            <Server name="legacy-soap-standby">
                <IsFallback>true</IsFallback>
            </Server>
            <MaxFailures>3</MaxFailures>
        </LoadBalancer>
        <Path>/storefront</Path>
    </HTTPTargetConnection>
</TargetEndpoint>
