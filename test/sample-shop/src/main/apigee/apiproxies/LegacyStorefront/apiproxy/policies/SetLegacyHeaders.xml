<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- expect AX113: Edge-era name without the AM- prefix -->
<AssignMessage async="false" continueOnError="false" enabled="true" name="SetLegacyHeaders">
    <DisplayName>SetLegacyHeaders</DisplayName>
    <Remove>
        <Headers>
            <Header name="x-api-key"/>
        </Headers>
    </Remove>
    <Set>
        <Headers>
            <Header name="X-Session-Id">{legacy.sessionId}</Header>
        </Headers>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
