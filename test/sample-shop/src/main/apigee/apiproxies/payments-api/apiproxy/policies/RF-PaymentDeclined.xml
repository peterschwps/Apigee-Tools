<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-PaymentDeclined">
    <DisplayName>RF-PaymentDeclined</DisplayName>
    <FaultResponse>
        <Set>
            <Payload contentType="application/json">{"error":"payment_declined","paymentId":"{payment.id}","declineCode":"{payment.declineCode}"}</Payload>
            <StatusCode>402</StatusCode>
            <ReasonPhrase>Payment Required</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
