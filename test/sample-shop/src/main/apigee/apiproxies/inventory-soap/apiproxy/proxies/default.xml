<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <Description>Stock levels as JSON, answered by the SOAP inventory service.</Description>
    <FaultRules>
        <FaultRule name="invalidStockRequest">
            <Step>
                <Name>AM-InvalidStockRequest</Name>
            </Step>
            <Condition>(messagevalidation.MV-ValidateStock.failed = true)</Condition>
        </FaultRule>
    </FaultRules>
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <Flows>
        <Flow name="checkStock">
            <Description>Stock of one SKU per size and color.</Description>
            <Request>
                <Step>
                    <Name>J2X-StockRequest</Name>
                </Step>
                <Step>
                    <Name>AM-SoapEnvelope</Name>
                </Step>
                <Step>
                    <Name>MV-ValidateStock</Name>
                </Step>
            </Request>
            <Response>
                <Step>
                    <Name>XSL-StockToJson</Name>
                </Step>
                <Step>
                    <Name>X2J-StockResponse</Name>
                </Step>
            </Response>
            <Condition>(proxy.pathsuffix MatchesPath "/stock") and (request.verb = "POST")</Condition>
        </Flow>
        <Flow name="unknownResource">
            <Request>
                <Step>
                    <Name>RF-UnknownResource</Name>
                </Step>
            </Request>
            <Response/>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/inventory</BasePath>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
