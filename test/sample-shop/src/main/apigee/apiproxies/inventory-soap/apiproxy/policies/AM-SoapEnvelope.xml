<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-SoapEnvelope">
    <DisplayName>AM-SoapEnvelope</DisplayName>
    <Set>
        <Headers>
            <Header name="SOAPAction">"urn:shop.example:inventory/CheckStock"</Header>
        </Headers>
        <!-- The default namespace on Body puts the converted request into the inventory namespace -->
        <Payload contentType="text/xml; charset=utf-8">
            <soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
                <soap:Body xmlns="urn:shop.example:inventory">{inventory.stockRequest}</soap:Body>
            </soap:Envelope>
        </Payload>
    </Set>
    <AssignVariable>
        <Name>target.copy.pathsuffix</Name>
        <Value>false</Value>
    </AssignVariable>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
