<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-InvalidOrder">
    <DisplayName>RF-InvalidOrder</DisplayName>
    <FaultResponse>
        <Set>
            <Payload contentType="application/json">{"error":"invalid_order","message":"{order.error}"}</Payload>
            <StatusCode>400</StatusCode>
            <ReasonPhrase>Bad Request</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
