<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <Description>Back office operations, reachable only from internal networks.</Description>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>AC-InternalNetworks</Name>
            </Step>
            <Step>
                <Name>RF-MissingCredentials</Name>
                <Condition>!(request.header.Authorization StartsWith "Basic ")</Condition>
            </Step>
            <Step>
                <Name>BA-DecodeCredentials</Name>
            </Step>
            <Step>
                <Name>AM-OperatorHeader</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows>
        <Flow name="listOrders">
            <Request/>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/orders") and (request.verb = "GET")</Condition>
        </Flow>
        <Flow name="refundOrder">
            <Request/>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/orders/*/refunds") and (request.verb = "POST")</Condition>
        </Flow>
        <Flow name="reindexCatalog">
            <Request/>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/catalog/reindex") and (request.verb = "POST")</Condition>
        </Flow>
        <Flow name="unknownResource">
            <Request>
                <Step>
                    <Name>RF-UnknownResource</Name>
                </Step>
            </Request>
            <Response/>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/admin</BasePath>
    </HTTPProxyConnection>
    <!-- expect AX102: a second base path needs its own proxy endpoint -->
    <BasePath>/admin/v2</BasePath>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
