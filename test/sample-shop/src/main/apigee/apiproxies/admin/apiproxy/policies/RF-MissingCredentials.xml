<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-MissingCredentials">
    <DisplayName>RF-MissingCredentials</DisplayName>
    <FaultResponse>
        <Set>
            <Headers>
                <Header name="WWW-Authenticate">Basic realm="shop admin"</Header>
            </Headers>
            <Payload contentType="application/json">{"error": "unauthorized", "message": "Sign in with your back office account."}</Payload>
            <StatusCode>401</StatusCode>
            <ReasonPhrase>Unauthorized</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
