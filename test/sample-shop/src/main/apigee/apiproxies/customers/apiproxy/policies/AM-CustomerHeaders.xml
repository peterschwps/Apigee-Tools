<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-CustomerHeaders">
    <DisplayName>AM-CustomerHeaders</DisplayName>
    <Remove>
        <Headers>
            <Header name="Authorization"/>
        </Headers>
    </Remove>
    <Set>
        <!-- expect AX101: Heders is a typo, so the backend never gets the customer id -->
        <Heders>
            <Header name="x-customer-id">{customer.id}</Header>
        </Heders>
    </Set>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
