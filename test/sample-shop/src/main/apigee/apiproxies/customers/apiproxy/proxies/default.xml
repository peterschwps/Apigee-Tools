<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <Description>Profiles of signed-in customers.</Description>
    <FaultRules>
        <FaultRule name="insufficientScope">
            <Step>
                <Name>AM-InsufficientScope</Name>
            </Step>
            <Condition>(fault.name = "InsufficientScope")</Condition>
        </FaultRule>
    </FaultRules>
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <Flows>
        <Flow name="getCustomer">
            <Description>Read a customer profile.</Description>
            <Request>
                <Step>
                    <Name>OA-VerifyReadScope</Name>
                </Step>
                <Step>
                    <Name>EV-CustomerId</Name>
                </Step>
                <Step>
                    <Name>RF-InvalidCustomerId</Name>
                    <Condition>!(customer.id ~~ "[0-9]+")</Condition>
                </Step>
                <Step>
                    <Name>AM-CustomerHeaders</Name>
                </Step>
            </Request>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/*") and (request.verb = "GET")</Condition>
        </Flow>
        <Flow name="updateCustomer">
            <Description>Replace a customer profile.</Description>
            <Request>
                <Step>
                    <Name>OA-VerifyWriteScope</Name>
                </Step>
                <Step>
                    <Name>EV-CustomerId</Name>
                </Step>
                <Step>
                    <Name>RF-InvalidCustomerId</Name>
                    <Condition>!(customer.id ~~ "[0-9]+")</Condition>
                </Step>
                <Step>
                    <Name>AM-CustomerHeaders</Name>
                </Step>
            </Request>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/*") and (request.verb = "PUT")</Condition>
        </Flow>
        <Flow name="unknownResource">
            <Request>
                <Step>
                    <Name>RF-UnknownResource</Name>
                </Step>
            </Request>
            <Response/>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/customers</BasePath>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
