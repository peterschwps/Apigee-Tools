<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:shop.example:inventory"
           xmlns="urn:shop.example:inventory"
           elementFormDefault="qualified">
