{
  "name": "apigee-tools",
  "displayName": "Apigee Tools",
  "publisher": "peterschwps",
  "description": "Diagnostics, completion, and quick fixes for Apigee X proxy and shared flow XML, based on Google's documentation.",
  "version": "0.1.4",
  "private": false,
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/peterschwps/Apigee-Tools.git"
  },
  "homepage": "https://github.com/peterschwps/Apigee-Tools#readme",
  "bugs": {
    "url": "https://github.com/peterschwps/Apigee-Tools/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "preview": true,
  "keywords": [
    "apigee",
    "apigee x",
    "api proxy",
    "shared flow",
    "google cloud",
    "api management",
    "xml",
    "linter"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "apigee-tools": "dist/cli.js"
  },
  "activationEvents": [
    "onLanguage:xml"
  ],
  "contributes": {
    "configuration": {
      "title": "Apigee Tools",
      "properties": {
        "apigeeTools.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Apigee X XML diagnostics and completions."
        },
        "apigeeTools.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns for Apigee X XML files to exclude."
        },
        "apigeeTools.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Diagnostic rule IDs to ignore, for example AX103."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/extension.ts src/cli.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --sourcemap --outdir=dist",
    "check": "npm run format:check && tsc -p tsconfig.json --noEmit && npm run data:validate && npm run comparison:validate",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "comparison:validate": "tsx scripts/compare-apigeelint.ts --validate",
    "compare:apigeelint": "tsx scripts/compare-apigeelint.ts",
    "data:validate": "tsx scripts/docs.ts validate",
    "docs:discover": "tsx scripts/docs.ts discover",
    "docs:extract": "tsx scripts/docs.ts extract",
    "docs:propose": "tsx scripts/docs.ts propose",
    "docs:refresh": "tsx scripts/docs.ts refresh",
    "docs:status": "tsx scripts/docs.ts status",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:integration": "npm run build && tsx test/integration/run.ts",
    "release:check": "tsx scripts/docs.ts release-check && npm run comparison:validate",
    "package:alpha": "vsce package --no-dependencies --pre-release",
    "package:npm": "npm run build && tsx scripts/npm-package.ts check",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@xml-tools/parser": "^1.0.11",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
