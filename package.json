{
  "name": "apigee-tools",
  "displayName": "Apigee Tools",
  "publisher": "peterschwps",
  "description": "Diagnostics, completion, and quick fixes for Apigee X proxy and shared flow XML, based on Google's documentation, and a read-only dashboard of an organization's deployments.",
  "version": "0.1.6",
  "private": false,
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/peterschwps/Apigee-Tools.git"
  },
  "homepage": "https://github.com/peterschwps/Apigee-Tools#readme",
  "bugs": {
    "url": "https://github.com/peterschwps/Apigee-Tools/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "apigee",
    "apigee x",
    "api proxy",
    "shared flow",
    "google cloud",
    "api management",
    "xml",
    "linter"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "apigee-tools": "dist/cli.js"
  },
  "activationEvents": [
    "onLanguage:xml",
    "onWebviewPanel:apigeeTools.dashboard",
    "workspaceContains:**/apiproxy/*.xml",
    "workspaceContains:**/sharedflowbundle/*.xml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Linting works in Restricted Mode. The dashboard runs gcloud and reads from the Apigee API, so it needs a trusted workspace."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Apigee Tools",
      "properties": {
        "apigeeTools.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Apigee X XML diagnostics and completions."
        },
        "apigeeTools.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns for Apigee X XML files to exclude."
        },
        "apigeeTools.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Diagnostic rule IDs to ignore, for example AX103."
        },
        "apigeeTools.gcloudPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the Google Cloud CLI executable for the dashboard (`gcloud.cmd` on Windows, `gcloud` on macOS/Linux). Leave empty to detect it on the extension host's `PATH`. Set this in User or Remote Settings."
        },
        "apigeeTools.gcloudConfiguration": {
          "type": "string",
          "default": "",
          "pattern": "^([a-z][-a-z0-9]*)?$",
          "patternErrorMessage": "Use the name of a gcloud configuration: lower-case letters, digits, and hyphens.",
          "markdownDescription": "Named gcloud configuration for the dashboard, as listed by `gcloud config configurations list`. Leave empty to use the active configuration."
        }
      }
    },
    "commands": [
      {
        "command": "apigeeTools.openDashboard",
        "title": "Open Dashboard",
        "category": "Apigee Tools",
        "icon": "$(dashboard)"
      }
    ]
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:extension && npm run build:webview && tsx scripts/notices.ts",
    "build:extension": "esbuild src/extension.ts src/cli.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --sourcemap --metafile=dist/meta-node.json --outdir=dist",
    "build:webview": "esbuild src/webview/main.ts src/webview/main.css node_modules/@vscode/codicons/dist/codicon.css --bundle --minify --sourcemap --format=iife --target=chrome128 --loader:.ttf=file \"--entry-names=[name]\" \"--asset-names=[name]\" --metafile=dist/meta-webview.json --outdir=dist/webview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/webview/tsconfig.json --noEmit",
    "check": "npm run format:check && npm run typecheck && npm run data:validate && npm run comparison:validate",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "comparison:validate": "tsx scripts/compare-apigeelint.ts --validate",
    "compare:apigeelint": "tsx scripts/compare-apigeelint.ts",
    "data:validate": "tsx scripts/docs.ts validate",
    "docs:discover": "tsx scripts/docs.ts discover",
    "docs:extract": "tsx scripts/docs.ts extract",
    "docs:propose": "tsx scripts/docs.ts propose",
    "docs:refresh": "tsx scripts/docs.ts refresh",
    "docs:status": "tsx scripts/docs.ts status",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:integration": "npm run build && tsx test/integration/run.ts",
    "release:check": "tsx scripts/docs.ts release-check && npm run comparison:validate",
    "package:alpha": "vsce package --no-dependencies --pre-release",
    "package:npm": "npm run build && tsx scripts/npm-package.ts check",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.45",
    "@xml-tools/parser": "^1.0.11",
    "lit": "^3.3.3",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
